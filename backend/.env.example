# --- Required ---------------------------------------------------------------
# PostgreSQL connection string for the shared Step360D database.
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Public origin of the CRM/Admin frontend, used for CORS and cookies.
WEB_ORIGIN="http://localhost:5173"

# --- Optional (defaults shown) ----------------------------------------------
PORT=3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_URL_BASE="http://localhost:5173/reset-password"

# Email delivery: "console" (development, logs the message) or "smtp".
EMAIL_TRANSPORT="console"
EMAIL_FROM="Step360D CRM <no-reply@step360d.local>"

# Required only when EMAIL_TRANSPORT="smtp".
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
