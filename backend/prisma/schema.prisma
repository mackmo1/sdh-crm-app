// Step360D CRM — Prisma schema
//
// The CRM shares ONE PostgreSQL database with the public website. Two of the
// tables below (`projects`, `property`) already exist there and are used by the
// live website. They are declared here exactly as they exist, and every phase-1
// change to `property` is additive (new nullable/defaulted columns only).
//
// Legacy columns that the website still reads are kept and kept in sync by the
// application: `property.listing` (free-text 'buy' | 'rent') and
// `property.project` (free-text project name). `property.status` is a legacy
// free-text column that the website writes; the CRM does not read or write it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ListingType {
  SALE
  RENT
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum AvailabilityStatus {
  AVAILABLE
  ON_HOLD
  SOLD
  RENTED
}

enum CrmModule {
  all
  lead
  property
}

enum StaffRole {
  admin
  data_user
}

// ---------------------------------------------------------------------------
// Pre-existing website tables
// ---------------------------------------------------------------------------

model Project {
  id              BigInt    @id @default(autoincrement())
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  name            String?   @db.VarChar
  address         String?   @db.VarChar
  city            String?   @db.VarChar
  google_location String?   @db.VarChar
  overview_area   String?   @db.VarChar
  near_by         String?
  overview_floors String?   @db.VarChar
  overview_rem1   String?   @db.VarChar
  overview_rem2   String?   @db.VarChar
  rooms           String?   @db.VarChar
  area_sqft       String?   @db.VarChar
  price_range     String?   @db.VarChar
  usp             String?
  external_id     String?   @db.VarChar
  pricing_tiers   Json?

  properties Property[]

  @@map("projects")
}

/// Permanent master record for every listing. Shared by the website and the CRM.
model Property {
  id             BigInt   @id @default(autoincrement())
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  listing        String   @db.VarChar
  type           String?  @db.VarChar
  city           String   @db.VarChar
  project        String?  @db.VarChar
  address        String   @db.VarChar
  pin_code       String?  @db.VarChar
  rooms          String   @db.VarChar
  parking        Boolean?
  price          Decimal  @db.Decimal
  facing         String?  @db.VarChar
  starting_dt    DateTime? @db.Date
  user_id        BigInt?
  area           BigInt?
  status         String?  @db.VarChar
  message        String?
  external_id    String?  @db.VarChar
  coverImagePath String?  @db.VarChar
  bathrooms      Int?     @db.SmallInt

  // --- Phase 1 additions -------------------------------------------------
  listing_type        ListingType?
  publication_status  PublicationStatus  @default(DRAFT)
  availability_status AvailabilityStatus @default(AVAILABLE)
  project_id          BigInt?
  unit_identifier     String?            @db.VarChar
  updated_at          DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  published_at        DateTime?          @db.Timestamptz(6)

  project_ref Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  sale         SaleProperty?
  rent         RentProperty?
  archiveEvents PropertyArchive[]

  @@unique([project_id, unit_identifier])
  @@index([publication_status, listing_type, availability_status])
  @@index([project_id])
  @@index([created_at])
  @@map("property")
}

// ---------------------------------------------------------------------------
// Listing subtypes — one row per property, PK is also the FK to the master
// ---------------------------------------------------------------------------

model SaleProperty {
  property_id      BigInt   @id
  price_negotiable Boolean? @db.Boolean
  ownership_type   String?  @db.VarChar
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  property Property @relation(fields: [property_id], references: [id], onDelete: Restrict)

  @@map("sale_property")
}

model RentProperty {
  property_id        BigInt   @id
  deposit_amount     Decimal? @db.Decimal
  maintenance_amount Decimal? @db.Decimal
  furnishing         String?  @db.VarChar
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  property Property @relation(fields: [property_id], references: [id], onDelete: Restrict)

  @@map("rent_property")
}

// ---------------------------------------------------------------------------
// Archive — append-only event log, never updated or deleted
// ---------------------------------------------------------------------------

model PropertyArchive {
  id                  BigInt            @id @default(autoincrement())
  property_id         BigInt
  listing_type        ListingType?
  previous_status     PublicationStatus
  previous_availability AvailabilityStatus
  snapshot            Json
  reason              String?
  archived_at         DateTime          @default(now()) @db.Timestamptz(6)
  archived_by         String?

  property Property @relation(fields: [property_id], references: [id], onDelete: Restrict)
  archived_by_user CrmUser? @relation(fields: [archived_by], references: [id], onDelete: Restrict)

  @@index([property_id, archived_at])
  @@map("property_archive")
}

// ---------------------------------------------------------------------------
// Staff — one table only, exact profile shape as agreed
// ---------------------------------------------------------------------------

model CrmUser {
  id         String      @id @default(uuid())
  name       String      @db.VarChar
  email      String      @unique @db.VarChar
  module     CrmModule
  role       StaffRole
  active     Boolean     @default(true)
  created_at DateTime    @default(now()) @db.Timestamptz(6)

  credential  CrmUserCredential?
  sessions    CrmSession[]
  resetTokens CrmPasswordResetToken[]
  archiveEvents PropertyArchive[]

  @@map("Crm_User")
}

/// Credentials are deliberately kept out of Crm_User.
model CrmUserCredential {
  crm_user_id         String   @id
  password_hash       String   @db.VarChar
  password_updated_at DateTime @default(now()) @db.Timestamptz(6)

  user CrmUser @relation(fields: [crm_user_id], references: [id], onDelete: Cascade)

  @@map("Crm_UserCredential")
}

model CrmSession {
  id           String    @id @default(uuid())
  crm_user_id  String
  token_hash   String    @unique @db.VarChar
  expires_at   DateTime  @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  user CrmUser @relation(fields: [crm_user_id], references: [id], onDelete: Cascade)

  @@index([crm_user_id])
  @@map("Crm_Session")
}

model CrmPasswordResetToken {
  id          String    @id @default(uuid())
  crm_user_id String
  token_hash  String    @unique @db.VarChar
  expires_at  DateTime  @db.Timestamptz(6)
  used_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  user CrmUser @relation(fields: [crm_user_id], references: [id], onDelete: Cascade)

  @@index([crm_user_id])
  @@map("Crm_PasswordResetToken")
}
